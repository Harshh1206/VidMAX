VIDMAX_ENVIRONMENT=development
VIDMAX_LOG_LEVEL=INFO
VIDMAX_DATABASE_URL=sqlite:///./vidmax.db
VIDMAX_STORAGE_DIR=./storage
VIDMAX_MAX_UPLOAD_BYTES=104857600
VIDMAX_MAX_OUTPUT_BYTES=524288000
VIDMAX_PROCESSING_TIMEOUT_SECONDS=120
VIDMAX_JOB_TTL_HOURS=24
VIDMAX_MEDIA_MIN_BYTES=1024
VIDMAX_FFPROBE_TIMEOUT_SECONDS=30
VIDMAX_DURATION_TOLERANCE_SECONDS=2.0
VIDMAX_FFMPEG_PATH=
VIDMAX_FFPROBE_PATH=
VIDMAX_ENABLE_LOCAL_UPLOADS=false
VIDMAX_ENABLE_YOUTUBE_PYTUBEFIX_DOWNLOAD=false
VIDMAX_YOUTUBE_DOWNLOAD_TIMEOUT_SECONDS=60
VIDMAX_YOUTUBE_DOWNLOAD_MAX_RETRIES=2
VIDMAX_ENABLE_METADATA_INSPECTION=true
VIDMAX_ENABLE_FACEBOOK_METADATA=false
VIDMAX_FACEBOOK_ACCESS_TOKEN=
VIDMAX_HTTP_TIMEOUT_SECONDS=5.0
